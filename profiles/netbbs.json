{
  "name": "Lunar Lander",
  "executable_path": "/usr/local/bin/python3",
  "args": ["{install_dir}/lunar_lander.py"],
  "profile": {
    "version": 1,
    "adapter": "native",
    "endpoint": "stdio",
    "install_dir": "/var/games/netbbs/lunar-lander",
    "encoding": "utf-8",
    "width": 0,
    "height": 0,
    "resize_signal": true,
    "time_limit": 1800,
    "cpu_seconds": 900,
    "max_sessions": 8,
    "multinode_certified": true,
    "environment": {"DOOR_LL_DATA_DIR": "/srv/bbs/netbbs.db.doors/lunar_lander"}
  }
}
